# Copy this file to .env and fill in what you need.
# .env is gitignored - never commit real keys.
# Easier alternative: run "email-workflow setup" and it writes this for you.

# --- AI providers ----------------------------------------------------------
# You only need ONE. Add more and the app falls back to them automatically
# when the first hits its quota, in the order set by ai.fallback.auto_order
# in config.yaml.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GROQ_API_KEY=              # https://console.groq.com/keys
OPENAI_API_KEY=            # https://platform.openai.com/api-keys
OPENROUTER_API_KEY=        # https://openrouter.ai/keys

# --- More than one key for the same provider -------------------------------
# A free tier belongs to an ACCOUNT, not to you. Three Gemini keys from three
# different Google accounts are three separate allowances, and the app uses
# them all: three emails at a time, one key each.
#
# Just number them. Anything named after the key variable above is picked up
# with no other configuration:
# GEMINI_API_KEY_2=        # a key from your second Google account
# GEMINI_API_KEY_3=        # a third account
# GEMINI_API_KEY_WORK=     # a name works as well as a number
#
# Same for the others: GROQ_API_KEY_2, OPENAI_API_KEY_2, and so on.
# The SAME key written twice under two names counts once - that is one
# account, and pretending otherwise just earns you a rate-limit error.

# --- Your mailbox ----------------------------------------------------------
# For Gmail this must be an App Password, not your normal password. Two steps,
# and the first one is the one everybody gets stuck on:
#
#   1. Turn on 2-Step Verification:
#      https://myaccount.google.com/signinoptions/twosv
#      Google does not offer app passwords at all until this is on. With it
#      off, the page below does not explain that - it only says the setting is
#      not available for your account, which looks like a broken page.
#   2. Create the app password:
#      https://myaccount.google.com/apppasswords
#      Name it anything, copy the 16 characters, remove the spaces.
#
# 'email-workflow setup' walks through both.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Only if your mailbox does not tell the app which folder is Drafts. It
# normally does, in whatever language your account is in ("Wersje robocze",
# "Entwurfe"), so leave this alone unless drafts are being refused.
# IMAP_DRAFTS_FOLDER=[Gmail]/Drafts

# Only needed for a non-Gmail mailbox.
# IMAP_SERVER=imap.example.com
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587

# --- Your knowledge base ---------------------------------------------------
# Normally this lives in known_facts.txt. That file is gitignored because it is
# personal, so it never reaches GitHub - which means a scheduled cloud run
# would know nothing about you. Put the same lines here (as a GitHub secret
# named KNOWN_FACTS) and the scheduled run uses them. The file wins locally.
# KNOWN_FACTS="- User Name: Your Name
- Work Hours: 9:00 to 17:00"

# --- Reports (all optional) ------------------------------------------------
DISCORD_WEBHOOK_URL=

NOTIFICATION_SENDER_EMAIL=
NOTIFICATION_SENDER_PASSWORD=
NOTIFICATION_RECIPIENT_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# --- Advanced --------------------------------------------------------------
# Force the project folder, if you run the command from somewhere unusual.
# EMAIL_WORKFLOW_ROOT=/path/to/email-workflow-lab
